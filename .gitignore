# ---- S32 Design Studio / Eclipse CDT build output ----
# Anchored to repo root: an unanchored "Debug/" also matches src/DEBUG/
# case-insensitively on Windows, which was silently hiding the
# DEBUG/debug_rtt.* logging sources from git.
/Debug_*/
/Release_*/
/Debug/
/Release/
*.o
*.d
*.su
*.args
*.map
*.elf
*.bin
*.hex
*.axf
*.srec
*.list
*.lst
*.sym

# ---- Eclipse / CDT workspace and index files ----
.metadata/
.recommenders/
.autotools
.cproject.bak
.project.bak

# ---- Backup folders/files (redundant with git history) ----
*.bak/
*.bak
src.zip
*.zip.bak

# ---- Google Drive sync artifacts ----
desktop.ini
.tmp.driveupload/
.tmp.drivedownload/
*.tmp.driveupload
*.tmp.drivedownload

# ---- Windows OS files ----
Thumbs.db
ehthumbs.db
$RECYCLE.BIN/
*.stackdump

# ---- Editor/IDE clutter ----
*.swp
*.swo
*~
.vscode/
.idea/

# ---- J-Link / debug session logs ----
*.jlink.log
JLinkLog.txt
