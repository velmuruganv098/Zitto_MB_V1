CM_ BO_ 2350376692 "send by BCM to HMI every 100ms
includes the information on switches connected to bcm";
CM_ SG_ 2350376692 BCM_H_KeyOnoff_Command "Stand sensor status from BCM to HMI.
0 - stand lifted
1 = stand not lifted";
CM_ SG_ 2350376692 BCM_Sw_Standsensor_status "Stand sensor status from BCM to HMI.
0 - stand lifted
1 = stand not lifted";
CM_ SG_ 2350376692 BCM_L_RightIndicator_Status "Right indicator status. This denotes if the light is on or off
0 - Off
1 - On
When an indicator is on, this bit will be toggling high and low
";
CM_ SG_ 2350376692 BCM_L_Leftindicator_status "Left indicator status. This denotes if the light is on or off
0 - Off
1 - On
When an indicator is on, this bit will be toggling high and low
";
CM_ SG_ 2350376692 BCM_L_HighBeam_Status "HIgh beam status from BCM
1 - high beam on
0 - hig beam off";
CM_ BO_ 2348941299 "Contains all the telemetry of motor controller
";
CM_ SG_ 2348941299 Current_Mode_Status "Status of mode from the motor controller.
";
CM_ SG_ 2348941299 Motor_OnOff_status "Status from motorcontroller if the motor is started or off state
0 -  motor stopped (off)
1  - motor started (on)";
CM_ BO_ 2350507764 "ODO meter reading from BCM is send to HMI for display
";
CM_ SG_ 2350507764 ODO_MeterReading "ODO meter reading from BCM
4 bytes is alloted";
CM_ BO_ 2350710769 "Fixed battery telemetry. 
";
